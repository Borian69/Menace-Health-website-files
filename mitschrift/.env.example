# Mitschrift – Konfiguration. Kopieren nach .env und ausfüllen.
# .env steht in .gitignore und gelangt nie ins Repository.

# ── Zugang ───────────────────────────────────────────────
# Gemeinsames Passwort für die App. Auf einem Server immer setzen.
APP_PASSWORD=
# Nur über HTTPS ausliefern? Hinter einem TLS-Proxy: true
COOKIE_SECURE=false
# Leer = wird beim ersten Start erzeugt und in storage/.secret abgelegt.
SESSION_SECRET=

# ── KI-Analyse über OpenRouter ───────────────────────────
# Schlüssel von https://openrouter.ai/keys – bleibt auf dem Server.
OPENROUTER_API_KEY=
# Modell austauschen = nur diese Zeile ändern.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_OUTPUT_TOKENS=8000
OPENROUTER_TIMEOUT_S=300
OPENROUTER_RETRIES=3
# Bis zu dieser Transkriptlänge (geschätzte Token) ein einziger Aufruf.
LLM_SINGLE_PASS_TOKENS=90000
# Abschnittsgröße für lange Transkripte (mehrstufige Zusammenfassung).
LLM_CHUNK_TOKENS=30000

# ── Transkription (lokal, faster-whisper) ────────────────
# tiny · base · small · medium · large-v3   (größer = genauer, langsamer)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leer = Sprache automatisch erkennen
WHISPER_LANGUAGE=de
WHISPER_BEAM_SIZE=1
WHISPER_VAD=true
# Lange Aufnahmen in Abschnitte dieser Länge (Minuten) teilen.
TRANSCRIBE_CHUNK_MINUTES=10

# ── Server ───────────────────────────────────────────────
MAX_UPLOAD_MB=1024
LOG_LEVEL=INFO
# Nur für die lokale Entwicklung mit getrenntem Vite-Server:
# CORS_ORIGINS=["http://localhost:5173"]
